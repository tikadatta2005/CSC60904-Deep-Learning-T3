   "source": [
    "# 2 Hidden layered MLP"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fb44361c",
   "metadata": {},
   "source": [
    "### Import Library\n",
    "- torch\n",
    "- datasets, transforms\n",
    "- dataloader"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "732df7be",
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "from torchvision import datasets, transforms\n",
    "from torch.utils.data import DataLoader"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c78e97af",
   "metadata": {},
   "source": [
    "## Load data for train, test and val split\n",
    "\n",
    "Tran dataset will be using some augmentations."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "0e4aaa8d",
   "metadata": {},
   "outputs": [],
   "source": [
    "transform = transforms.Compose([\n",
    "    transforms.Resize((112,112)),\n",
    "    transforms.ToTensor()\n",
    "])\n",
    "\n",
    "train_data_set = datasets.ImageFolder(\"../datasets/final_dataset/train\", transform=transform)\n",
    "val_data_set = datasets.ImageFolder(\"../datasets/final_dataset/val\", transform=transform)\n",
    "\n",
    "train = DataLoader(\n",
    "    train_data_set, \n",
    "    batch_size=32, \n",
    "    num_workers=4, \n",
    "    persistent_workers=True, \n",
    "    pin_memory=True, \n",
    "    shuffle=True\n",
    "    )\n",
    "\n",
    "val = DataLoader(\n",
    "    val_data_set,\n",
    "    batch_size=32, \n",
    "    num_workers=4, \n",
    "    persistent_workers=True, \n",
    "    pin_memory=True, \n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4399c9a4",
   "metadata": {},
   "source": [
    "## Train the model"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "94edf904",
   "metadata": {},
   "source": [
    "### Load modules and architecture\n",
    "* Trainer,\n",
    "* Architecture"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "29901cc8",
   "metadata": {},
   "outputs": [],
   "source": [
    "from modules.helper.trainer import  Trainer\n",
    "from modules.architectures.Architecture import Architecture\n",
    "from modules.helper.charts import gen_line_charts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "4408302d",
   "metadata": {},
   "outputs": [],
   "source": [
    "def find_best_models(df):\n",
    "    best = df[df[\"val_accuracy\"] == df[\"val_accuracy\"].max()] # combines and remove duplicates\n",
    "    return best"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "70fb0596",
   "metadata": {},
   "source": [
    "### Load and Construct a architecture"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "1c5a3418",
   "metadata": {},
   "outputs": [],
   "source": [
    "torch.manual_seed(41)\n",
    "model = Architecture()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "255966bf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "TOTAL TRAINABLE PARAMETERS = 39,233,700\n"
     ]
    }
   ],
   "source": [
    "# Input size\n",
    "flatten_size = 3 * 112 * 112\n",
    "\n",
    "\n",
    "# Define model\n",
    "model = nn.Sequential(\n",
    "    nn.Flatten(),\n",
    "\n",
    "    # First hidden layer\n",
    "    nn.Linear(flatten_size, 1024),\n",
    "    nn.BatchNorm1d(1024),\n",
    "    nn.ReLU(),\n",
    "\n",
    "    # Second hidden layer\n",
    "    nn.Linear(1024, 512),\n",
    "    nn.BatchNorm1d(512),\n",
    "    nn.ReLU(),\n",
    "    \n",
    "    # third hidden layer\n",
    "    nn.Linear(512, 256),\n",
    "    nn.BatchNorm1d(256),\n",
    "    nn.ReLU(),\n",
    "    \n",
    "    # fourth hidden layer\n",
    "    nn.Linear(256, 128),\n",
    "    nn.BatchNorm1d(128),\n",
    "    nn.ReLU(),\n",
    "\n",
    "    # Output layer\n",
    "    nn.Linear(128, 36)\n",
    ")\n",
    "\n",
    "# Calculate trainable parameters\n",
    "total_params = sum(\n",
    "    p.numel()\n",
    "    for p in model.parameters()\n",
    "    if p.requires_grad\n",
    ")\n",
    "\n",
    "print(f\"TOTAL TRAINABLE PARAMETERS = {total_params:,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "b7609ed7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
